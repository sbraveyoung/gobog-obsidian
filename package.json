{
  "name": "gobog-obsidian",
  "version": "0.5.0",
  "description": "Two-way sync between an Obsidian folder and a GitHub markdown repo, with auto front-matter for new notes. Companion to the gobog blog engine.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node tests/build.cjs && node --test tests/*.test.cjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "blog",
    "github-pages",
    "static-site",
    "gobog"
  ],
  "license": "MIT",
  "dependencies": {
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "linkedom": "0.18.12",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "yaml": "^2.9.1"
  }
}
